{
  "name": "@liquistock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "start": "tsx src/interfaces/http/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "db:reset": "tsx src/infrastructure/db/reset.ts && tsx src/infrastructure/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.1.0",
    "@liquistock/domain": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.2",
    "pg": "^8.14.1",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
