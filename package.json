{
  "name": "liquistock",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "pnpm --filter @liquistock/api dev",
    "dev:web": "pnpm --filter @liquistock/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @liquistock/api db:migrate",
    "db:seed": "pnpm --filter @liquistock/api db:seed",
    "db:reset": "pnpm --filter @liquistock/api db:reset"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

