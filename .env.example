NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Local dev uses embedded PostgreSQL 16 (PGlite).
# In production (Render), set your Neon pooled connection string (?sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=pglite://./data/pgdata

# Comma-separated frontend origins allowed by CORS (no trailing slash needed)
CORS_ORIGIN=http://localhost:5174

# Use a strong random 32+ character secret in production
JWT_SECRET=change-me-in-production-liquistock-secret

# Local disk fallback for image uploads (dev only; Render disk is ephemeral)
UPLOAD_DIR=./uploads

# Optional Cloudinary credentials for persistent image uploads in production (free tier)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=liquistock

# Frontend (Vercel / Cloudflare Pages) environment variables:
# VITE_API_URL=https://liquistock-api.onrender.com
# VITE_WS_URL is optional — automatically derived as wss:// from VITE_API_URL if omitted
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
